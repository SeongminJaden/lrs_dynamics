<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>hpop_maneuver</name>
  <version>1.0.0</version>
  <description>Orbital maneuver planning for HPOP system - Hohmann transfers, Lambert solver, rendezvous</description>
  <maintainer email="roboticsmaster@naver.com">Seongmin Jaden Lee</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>hpop_msgs</depend>
  <depend>hpop_core</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
