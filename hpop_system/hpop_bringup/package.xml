<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>hpop_bringup</name>
  <version>1.0.0</version>
  <description>HPOP System bringup launch files and configurations</description>
  <maintainer email="roboticsmaster@naver.com">Seongmin Jaden Lee</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>hpop_core</exec_depend>
  <exec_depend>hpop_perturbations</exec_depend>
  <exec_depend>hpop_tle</exec_depend>
  <exec_depend>hpop_analysis</exec_depend>
  <exec_depend>hpop_maneuver</exec_depend>
  <exec_depend>hpop_rviz_plugins</exec_depend>
  <exec_depend>hpop_msgs</exec_depend>

  <exec_depend>rviz2</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
