# Execute an orbital maneuver (simulation)

# Goal
string satellite_id          # Satellite to maneuver
hpop_msgs/ManeuverPlan maneuver  # Maneuver to execute
bool wait_for_ignition       # Wait until ignition time (real-time)
float64 time_acceleration    # Time acceleration factor (1.0 = real-time)
---
# Result
bool success
string message

hpop_msgs/SatelliteState pre_maneuver_state   # State before maneuver
hpop_msgs/SatelliteState post_maneuver_state  # State after maneuver
geometry_msgs/Vector3 actual_delta_v  # [m/s] Actual delta-V applied
float64 delta_v_error        # [m/s] Difference from planned
float64 execution_duration   # [s] Actual burn duration
---
# Feedback
uint8 PHASE_WAITING = 0
uint8 PHASE_COUNTDOWN = 1
uint8 PHASE_IGNITION = 2
uint8 PHASE_BURNING = 3
uint8 PHASE_CUTOFF = 4
uint8 PHASE_COMPLETE = 5
uint8 current_phase

float64 time_to_ignition     # [s] Time until ignition (negative if burning)
float64 burn_progress        # [0-1] Burn completion
geometry_msgs/Vector3 accumulated_delta_v  # [m/s] Delta-V applied so far
hpop_msgs/SatelliteState current_state  # Current state during maneuver
