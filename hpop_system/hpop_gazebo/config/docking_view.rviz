Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
  - Class: hpop_gazebo/MissionControlPanel
    Name: Mission Control

Visualization Manager:
  Class: ""
  Displays:
    # Grid for reference (docking frame centered)
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
      Cell Size: 1.0
      Line Style:
        Line Width: 0.03
        Value: Lines
      Normal Cell Count: 0
      Plane: XY
      Plane Cell Count: 50
      Reference Frame: docking_frame
      Color: 100; 100; 100

    # TF display
    - Class: rviz_default_plugins/TF
      Enabled: true
      Name: TF
      Frame Timeout: 999999
      Frames:
        All Enabled: false
        docking_frame:
          Value: true
        dummy_root:
          Value: true
        base_link:
          Value: true
        end_link:
          Value: true
        target/target_base_link:
          Value: true
      Marker Scale: 0.2
      Show Arrows: true
      Show Axes: true
      Show Names: true

    # Chaser Robot Model (at origin)
    - Class: rviz_default_plugins/RobotModel
      Enabled: true
      Name: ChaserRobot
      Description Topic:
        Value: /robot_description
      Visual Enabled: true
      Alpha: 1.0

    # Target Robot Model (relative position)
    - Class: rviz_default_plugins/RobotModel
      Enabled: true
      Name: TargetRobot
      Description Topic:
        Value: /target/robot_description
      TF Prefix: target
      Visual Enabled: true
      Alpha: 0.9

    # Distance indicator line
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Name: DistanceLine
      Topic:
        Value: /rendezvous/distance_marker

    # Interactive Markers for MoveIt2
    - Class: rviz_default_plugins/InteractiveMarkers
      Enabled: true
      Name: MoveItMarkers
      Update Topic:
        Value: /rviz_moveit_motion_planning_display/robot_interaction_interactive_marker_topic/update

  Enabled: true
  Global Options:
    Background Color: 20; 20; 30
    Fixed Frame: docking_frame
    Frame Rate: 30

  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Interact

  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 5
      Enable Stereo Rendering:
        Value: false
      Focal Point:
        X: 2
        Y: 0
        Z: 0
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 0.4
      Target Frame: docking_frame
      Value: Orbit (rviz_default_plugins)
      Yaw: 0.5

Window Geometry:
  Height: 900
  Width: 1400
  X: 50
  Y: 50
