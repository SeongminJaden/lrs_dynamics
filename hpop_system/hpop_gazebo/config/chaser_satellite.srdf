<?xml version="1.0" encoding="UTF-8"?>
<!--
  SRDF for Chaser Satellite with OpenMANIPULATOR-P Robot Arm
  Defines planning groups, end effector, and collision settings
-->
<robot name="chaser_satellite">
  <!-- Planning group for the robot arm -->
  <group name="arm">
    <chain base_link="arm_base" tip_link="magnetic_end_effector"/>
  </group>

  <!-- End effector group -->
  <group name="end_effector">
    <link name="magnetic_end_effector"/>
    <link name="magnet_contact_point"/>
  </group>

  <!-- End effector definition -->
  <end_effector name="magnetic_gripper" parent_link="end_link" group="end_effector"/>

  <!-- Group states (predefined poses for Canadarm-style arm) -->
  <!-- Joint limits: j1/j4/j6=[-pi,pi], j2/j3/j5=[-0.75pi,0.75pi] -->

  <group_state name="home" group="arm">
    <joint name="joint1" value="0.0"/>
    <joint name="joint2" value="0.0"/>
    <joint name="joint3" value="0.0"/>
    <joint name="joint4" value="0.0"/>
    <joint name="joint5" value="0.0"/>
    <joint name="joint6" value="0.0"/>
  </group_state>

  <group_state name="ready" group="arm">
    <joint name="joint1" value="0.0"/>
    <joint name="joint2" value="0.5"/>
    <joint name="joint3" value="-0.3"/>
    <joint name="joint4" value="0.0"/>
    <joint name="joint5" value="-0.2"/>
    <joint name="joint6" value="0.0"/>
  </group_state>

  <group_state name="capture" group="arm">
    <joint name="joint1" value="0.0"/>
    <joint name="joint2" value="0.8"/>
    <joint name="joint3" value="-0.5"/>
    <joint name="joint4" value="0.0"/>
    <joint name="joint5" value="-0.3"/>
    <joint name="joint6" value="0.0"/>
  </group_state>

  <group_state name="extended" group="arm">
    <joint name="joint1" value="0.0"/>
    <joint name="joint2" value="1.57"/>
    <joint name="joint3" value="0.0"/>
    <joint name="joint4" value="0.0"/>
    <joint name="joint5" value="0.0"/>
    <joint name="joint6" value="0.0"/>
  </group_state>

  <!-- Virtual joint connecting robot to world -->
  <virtual_joint name="virtual_joint" type="fixed" parent_frame="world" child_link="dummy_root"/>

  <!-- Disable collision checking between adjacent links -->
  <disable_collisions link1="base_link" link2="arm_base" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="solar_panel_1" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="solar_panel_2" reason="Adjacent"/>
  <disable_collisions link1="arm_base" link2="link1" reason="Adjacent"/>
  <disable_collisions link1="link1" link2="link2" reason="Adjacent"/>
  <disable_collisions link1="link2" link2="link3" reason="Adjacent"/>
  <disable_collisions link1="link3" link2="link4" reason="Adjacent"/>
  <disable_collisions link1="link4" link2="link5" reason="Adjacent"/>
  <disable_collisions link1="link5" link2="link6" reason="Adjacent"/>
  <disable_collisions link1="link6" link2="end_link" reason="Adjacent"/>
  <disable_collisions link1="end_link" link2="magnetic_end_effector" reason="Adjacent"/>
  <disable_collisions link1="magnetic_end_effector" link2="magnet_contact_point" reason="Adjacent"/>

  <!-- Disable collision between solar panels and arm -->
  <disable_collisions link1="solar_panel_1" link2="link1" reason="Never"/>
  <disable_collisions link1="solar_panel_2" link2="link1" reason="Never"/>
  <disable_collisions link1="solar_panel_1" link2="link2" reason="Never"/>
  <disable_collisions link1="solar_panel_2" link2="link2" reason="Never"/>
</robot>
