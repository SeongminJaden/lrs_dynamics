<?xml version="1.0"?>
<sdf version="1.6">
  <world name="satellite_capture">
    <!-- Physics settings for space (optimized for performance) -->
    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
      <ode>
        <solver>
          <type>quick</type>
          <iters>20</iters>
        </solver>
      </ode>
    </physics>

    <!-- No gravity (microgravity environment) -->
    <gravity>0 0 0</gravity>

    <!-- Space background (no sky - pure black space) -->
    <scene>
      <ambient>0.3 0.3 0.3 1</ambient>
      <background>0 0 0 1</background>
      <shadows>false</shadows>
    </scene>

    <!-- Main Sun light - bright directional -->
    <light type="directional" name="sun">
      <pose>100 50 100 0 0 0</pose>
      <diffuse>1.0 1.0 0.9 1</diffuse>
      <specular>1.0 1.0 1.0 1</specular>
      <direction>-0.5 -0.2 -0.8</direction>
      <cast_shadows>false</cast_shadows>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.0</linear>
        <quadratic>0.0</quadratic>
      </attenuation>
    </light>

    <!-- Fill light from opposite side -->
    <light type="directional" name="fill_light">
      <pose>-50 -20 50 0 0 0</pose>
      <diffuse>0.4 0.4 0.5 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>0.5 0.2 -0.5</direction>
      <cast_shadows>false</cast_shadows>
    </light>

    <!-- Point light near satellites for visibility -->
    <light type="point" name="workspace_light">
      <pose>1 0 2 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <attenuation>
        <range>50</range>
        <constant>0.5</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <cast_shadows>false</cast_shadows>
    </light>

    <!-- Additional point light below -->
    <light type="point" name="bottom_light">
      <pose>0 0 -3 0 0 0</pose>
      <diffuse>0.3 0.3 0.4 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation>
        <range>30</range>
        <constant>0.5</constant>
        <linear>0.02</linear>
        <quadratic>0.002</quadratic>
      </attenuation>
      <cast_shadows>false</cast_shadows>
    </light>

    <!-- Gazebo ROS State Plugin for SetEntityState service -->
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros>
        <namespace>/gazebo</namespace>
      </ros>
      <update_rate>50.0</update_rate>
    </plugin>

  </world>
</sdf>
