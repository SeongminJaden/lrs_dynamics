<?xml version="1.0"?>
<sdf version="1.6">
  <world name="satellite_capture">
    <!-- Physics settings for space -->
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
      <ode>
        <solver>
          <type>quick</type>
          <iters>50</iters>
        </solver>
      </ode>
    </physics>

    <!-- No gravity (microgravity environment) -->
    <gravity>0 0 0</gravity>

    <!-- Space background -->
    <scene>
      <ambient>0.1 0.1 0.1 1</ambient>
      <background>0 0 0 1</background>
      <shadows>true</shadows>
    </scene>

    <!-- Sun light (from the Sun direction) -->
    <light type="directional" name="sun">
      <pose>0 0 100 0 0 0</pose>
      <diffuse>1.0 1.0 0.95 1</diffuse>
      <specular>0.5 0.5 0.5 1</specular>
      <direction>0.3 0.1 -1</direction>
      <cast_shadows>true</cast_shadows>
    </light>

    <!-- Ambient light for visibility -->
    <light type="point" name="ambient_light">
      <pose>0 0 50 0 0 0</pose>
      <diffuse>0.3 0.3 0.35 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation>
        <range>200</range>
        <constant>0.5</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <cast_shadows>false</cast_shadows>
    </light>

    <!-- Simple target satellite -->
    <model name="target_satellite">
      <pose>8 0 0 0 0.1 0.05</pose>
      <link name="target_body">
        <pose>0 0 0 0 0 0</pose>
        <inertial>
          <mass>500</mass>
          <inertia>
            <ixx>83.33</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>166.67</iyy>
            <iyz>0</iyz>
            <izz>166.67</izz>
          </inertia>
        </inertial>
        <visual name="body_visual">
          <geometry>
            <box><size>1.5 1.0 1.0</size></box>
          </geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>
        <collision name="body_collision">
          <geometry>
            <box><size>1.5 1.0 1.0</size></box>
          </geometry>
        </collision>
      </link>

      <!-- Docking port (green sphere for visibility) -->
      <link name="magnetic_contact_surface">
        <pose>0.85 0 0 0 0 0</pose>
        <inertial>
          <mass>1</mass>
          <inertia>
            <ixx>0.01</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.01</iyy><iyz>0</iyz><izz>0.01</izz>
          </inertia>
        </inertial>
        <visual name="visual">
          <geometry>
            <sphere><radius>0.1</radius></sphere>
          </geometry>
          <material>
            <ambient>0.2 0.8 0.2 1</ambient>
            <diffuse>0.2 0.8 0.2 1</diffuse>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <sphere><radius>0.1</radius></sphere>
          </geometry>
        </collision>
      </link>

      <joint name="dock_joint" type="fixed">
        <parent>target_body</parent>
        <child>magnetic_contact_surface</child>
      </joint>

      <!-- Solar panels -->
      <link name="solar1">
        <pose>0 1.0 0 0 0 0</pose>
        <inertial><mass>20</mass><inertia><ixx>3</ixx><ixy>0</ixy><ixz>0</ixz><iyy>10</iyy><iyz>0</iyz><izz>10</izz></inertia></inertial>
        <visual name="v">
          <geometry><box><size>2.0 0.03 1.0</size></box></geometry>
          <material><ambient>0.1 0.2 0.5 1</ambient><diffuse>0.1 0.2 0.5 1</diffuse></material>
        </visual>
      </link>
      <joint name="s1" type="fixed"><parent>target_body</parent><child>solar1</child></joint>

      <link name="solar2">
        <pose>0 -1.0 0 0 0 0</pose>
        <inertial><mass>20</mass><inertia><ixx>3</ixx><ixy>0</ixy><ixz>0</ixz><iyy>10</iyy><iyz>0</iyz><izz>10</izz></inertia></inertial>
        <visual name="v">
          <geometry><box><size>2.0 0.03 1.0</size></box></geometry>
          <material><ambient>0.1 0.2 0.5 1</ambient><diffuse>0.1 0.2 0.5 1</diffuse></material>
        </visual>
      </link>
      <joint name="s2" type="fixed"><parent>target_body</parent><child>solar2</child></joint>
    </model>

    <!-- Gazebo ROS plugins -->
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros>
        <namespace>/gazebo</namespace>
      </ros>
      <update_rate>50.0</update_rate>
    </plugin>

    <plugin name="gazebo_ros_factory" filename="libgazebo_ros_factory.so">
    </plugin>

  </world>
</sdf>
