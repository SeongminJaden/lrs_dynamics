<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="chaser_satellite">

  <!-- Package path for config files -->
  <xacro:property name="pkg_path" value="$(find hpop_gazebo)"/>

  <!-- 6U CubeSat Properties (10cm x 20cm x 30cm - 2x3U config) -->
  <xacro:property name="cubesat_unit" value="0.1"/>  <!-- 10cm = 1U -->
  <xacro:property name="satellite_x" value="${cubesat_unit}"/>       <!-- 10cm -->
  <xacro:property name="satellite_y" value="${2*cubesat_unit}"/>     <!-- 20cm (2U) -->
  <xacro:property name="satellite_z" value="${3*cubesat_unit}"/>     <!-- 30cm (3U) -->
  <xacro:property name="satellite_mass" value="12.0"/>  <!-- 12kg typical for 6U -->

  <!-- Robot arm: Canadarm-style (thin and long, ~2m reach) -->

  <!-- Materials -->
  <material name="cubesat_body">
    <color rgba="0.3 0.3 0.3 1.0"/>  <!-- Dark grey aluminum -->
  </material>
  <material name="solar_cell">
    <color rgba="0.1 0.1 0.5 1.0"/>  <!-- Dark blue solar cells -->
  </material>
  <material name="grey">
    <color rgba="0.6 0.6 0.6 1.0"/>
  </material>
  <material name="magnet_red">
    <color rgba="0.9 0.2 0.2 1.0"/>
  </material>

  <!-- Dummy root link for KDL (no inertia) -->
  <link name="dummy_root"/>

  <joint name="dummy_to_base" type="fixed">
    <parent link="dummy_root"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Base link (Large satellite body like ISS module) -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${satellite_x} ${satellite_y} ${satellite_z}"/>
      </geometry>
      <material name="cubesat_body"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${satellite_x} ${satellite_y} ${satellite_z}"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${satellite_mass}"/>
      <inertia ixx="${satellite_mass*(satellite_y*satellite_y+satellite_z*satellite_z)/12}"
               ixy="0" ixz="0"
               iyy="${satellite_mass*(satellite_x*satellite_x+satellite_z*satellite_z)/12}"
               iyz="0"
               izz="${satellite_mass*(satellite_x*satellite_x+satellite_y*satellite_y)/12}"/>
    </inertial>
  </link>

  <!-- Deployable Solar Panel 1 (+Y side) - 6U size -->
  <link name="solar_panel_1">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${satellite_z} 0.003 ${satellite_z*0.8}"/>
      </geometry>
      <material name="solar_cell"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${satellite_z} 0.003 ${satellite_z*0.8}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.3"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.004" iyz="0" izz="0.004"/>
    </inertial>
  </link>

  <joint name="solar_panel_1_joint" type="fixed">
    <parent link="base_link"/>
    <child link="solar_panel_1"/>
    <origin xyz="0 ${satellite_y/2 + satellite_z/2 + 0.005} 0" rpy="0 0 0"/>
  </joint>

  <!-- Deployable Solar Panel 2 (-Y side) - 6U size -->
  <link name="solar_panel_2">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${satellite_z} 0.003 ${satellite_z*0.8}"/>
      </geometry>
      <material name="solar_cell"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${satellite_z} 0.003 ${satellite_z*0.8}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.3"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.004" iyz="0" izz="0.004"/>
    </inertial>
  </link>

  <joint name="solar_panel_2_joint" type="fixed">
    <parent link="base_link"/>
    <child link="solar_panel_2"/>
    <origin xyz="0 ${-satellite_y/2 - satellite_z/2 - 0.005} 0" rpy="0 0 0"/>
  </joint>

  <!-- Arm mounting point on +X face -->
  <link name="arm_base">
    <visual>
      <origin xyz="0 0 0.012" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.02" length="0.024"/>
      </geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.012" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.02" length="0.024"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.00002" ixy="0" ixz="0" iyy="0.00002" iyz="0" izz="0.00002"/>
    </inertial>
  </link>

  <joint name="arm_base_joint" type="fixed">
    <parent link="base_link"/>
    <child link="arm_base"/>
    <origin xyz="${satellite_x/2} 0 ${satellite_z/4}" rpy="0 ${pi/2} 0"/>
  </joint>

  <!-- =========================================== -->
  <!-- Canadarm-style Robot Arm (7 DOF) - Thin and Long -->
  <!-- Total reach: ~2m (comparable to satellite scale) -->
  <!-- =========================================== -->

  <!-- Arm dimensions (Canadarm-like proportions) -->
  <xacro:property name="arm_tube_radius" value="0.015"/>  <!-- 15mm thin tube -->
  <xacro:property name="joint_radius" value="0.025"/>     <!-- Joint housing -->
  <xacro:property name="boom_length_1" value="0.6"/>      <!-- Upper boom: 60cm -->
  <xacro:property name="boom_length_2" value="0.6"/>      <!-- Lower boom: 60cm -->
  <xacro:property name="wrist_length" value="0.3"/>       <!-- Wrist section: 30cm -->

  <!-- Link 1 (Base rotation housing) -->
  <link name="link1">
    <visual>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${joint_radius}" length="0.06"/>
      </geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${joint_radius}" length="0.06"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <mass value="0.3"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.00005"/>
    </inertial>
  </link>

  <joint name="arm_mount_joint" type="fixed">
    <parent link="arm_base"/>
    <child link="link1"/>
    <origin xyz="0 0 0.024" rpy="0 0 0"/>
  </joint>

  <!-- Joint 1 (base yaw - rotation around Z) -->
  <joint name="joint1" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="0.0 0.0 0.06" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit velocity="1.0" effort="50" lower="${-pi}" upper="${pi}"/>
    <dynamics damping="1.0"/>
  </joint>

  <!-- Link 2 (Shoulder pitch joint housing) -->
  <link name="link2">
    <visual>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${joint_radius}" length="0.04"/>
      </geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${joint_radius}" length="0.04"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <mass value="0.2"/>
      <inertia ixx="0.00005" ixy="0.0" ixz="0.0" iyy="0.00005" iyz="0.0" izz="0.00003"/>
    </inertial>
  </link>

  <!-- Joint 2 (shoulder pitch) -->
  <joint name="joint2" type="revolute">
    <parent link="link2"/>
    <child link="link3"/>
    <origin xyz="0.0 0.0 0.04" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit velocity="1.0" effort="50" lower="${-pi*0.75}" upper="${pi*0.75}"/>
    <dynamics damping="1.0"/>
  </joint>

  <!-- Link 3 (Upper boom - long thin tube) -->
  <link name="link3">
    <visual>
      <origin xyz="${boom_length_1/2} 0 0" rpy="0 ${pi/2} 0"/>
      <geometry>
        <cylinder radius="${arm_tube_radius}" length="${boom_length_1}"/>
      </geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin xyz="${boom_length_1/2} 0 0" rpy="0 ${pi/2} 0"/>
      <geometry>
        <cylinder radius="${arm_tube_radius}" length="${boom_length_1}"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="${boom_length_1/2} 0 0" rpy="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.015" iyz="0.0" izz="0.015"/>
    </inertial>
  </link>

  <!-- Joint 3 (elbow pitch) -->
  <joint name="joint3" type="revolute">
    <parent link="link3"/>
    <child link="link4"/>
    <origin xyz="${boom_length_1} 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit velocity="1.0" effort="50" lower="${-pi*0.75}" upper="${pi*0.75}"/>
    <dynamics damping="1.0"/>
  </joint>

  <!-- Link 4 (Elbow joint housing + Lower boom) -->
  <link name="link4">
    <!-- Elbow joint housing -->
    <visual>
      <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
      <geometry>
        <cylinder radius="${joint_radius}" length="0.04"/>
      </geometry>
      <material name="grey"/>
    </visual>
    <!-- Lower boom (thin tube) -->
    <visual>
      <origin xyz="${boom_length_2/2} 0 0" rpy="0 ${pi/2} 0"/>
      <geometry>
        <cylinder radius="${arm_tube_radius}" length="${boom_length_2}"/>
      </geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin xyz="${boom_length_2/2} 0 0" rpy="0 ${pi/2} 0"/>
      <geometry>
        <cylinder radius="${arm_tube_radius}" length="${boom_length_2}"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="${boom_length_2/2} 0 0" rpy="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.015" iyz="0.0" izz="0.015"/>
    </inertial>
  </link>

  <!-- Joint 4 (wrist roll) -->
  <joint name="joint4" type="revolute">
    <parent link="link4"/>
    <child link="link5"/>
    <origin xyz="${boom_length_2} 0 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit velocity="1.5" effort="30" lower="${-pi}" upper="${pi}"/>
    <dynamics damping="0.5"/>
  </joint>

  <!-- Link 5 (Wrist roll housing) -->
  <link name="link5">
    <visual>
      <origin xyz="0.02 0 0" rpy="0 ${pi/2} 0"/>
      <geometry>
        <cylinder radius="${joint_radius*0.8}" length="0.04"/>
      </geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin xyz="0.02 0 0" rpy="0 ${pi/2} 0"/>
      <geometry>
        <cylinder radius="${joint_radius*0.8}" length="0.04"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.02 0 0" rpy="0 0 0"/>
      <mass value="0.15"/>
      <inertia ixx="0.00002" ixy="0.0" ixz="0.0" iyy="0.00002" iyz="0.0" izz="0.00002"/>
    </inertial>
  </link>

  <!-- Joint 5 (wrist pitch) -->
  <joint name="joint5" type="revolute">
    <parent link="link5"/>
    <child link="link6"/>
    <origin xyz="0.04 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit velocity="1.5" effort="30" lower="${-pi*0.75}" upper="${pi*0.75}"/>
    <dynamics damping="0.5"/>
  </joint>

  <!-- Link 6 (Wrist pitch housing + extension) -->
  <link name="link6">
    <visual>
      <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
      <geometry>
        <cylinder radius="${joint_radius*0.8}" length="0.03"/>
      </geometry>
      <material name="grey"/>
    </visual>
    <!-- Wrist extension tube -->
    <visual>
      <origin xyz="${wrist_length/2} 0 0" rpy="0 ${pi/2} 0"/>
      <geometry>
        <cylinder radius="${arm_tube_radius*0.8}" length="${wrist_length}"/>
      </geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin xyz="${wrist_length/2} 0 0" rpy="0 ${pi/2} 0"/>
      <geometry>
        <cylinder radius="${arm_tube_radius*0.8}" length="${wrist_length}"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="${wrist_length/2} 0 0" rpy="0 0 0"/>
      <mass value="0.2"/>
      <inertia ixx="0.00002" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
    </inertial>
  </link>

  <!-- Joint 6 (end effector yaw) -->
  <joint name="joint6" type="revolute">
    <parent link="link6"/>
    <child link="end_link"/>
    <origin xyz="${wrist_length} 0 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit velocity="2.0" effort="20" lower="${-pi}" upper="${pi}"/>
    <dynamics damping="0.3"/>
  </joint>

  <!-- End link (End effector mount) -->
  <link name="end_link">
    <visual>
      <origin xyz="0.015 0 0" rpy="0 ${pi/2} 0"/>
      <geometry>
        <cylinder radius="${joint_radius*0.6}" length="0.03"/>
      </geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin xyz="0.015 0 0" rpy="0 ${pi/2} 0"/>
      <geometry>
        <cylinder radius="${joint_radius*0.6}" length="0.03"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.015 0 0" rpy="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="0.000001" ixy="0.0" ixz="0.0" iyy="0.000001" iyz="0.0" izz="0.000001"/>
    </inertial>
  </link>

  <!-- =========================================== -->
  <!-- Magnetic End Effector (Canadarm-style gripper) -->
  <!-- =========================================== -->

  <joint name="magnet_joint" type="fixed">
    <parent link="end_link"/>
    <child link="magnetic_end_effector"/>
    <origin xyz="0.03 0 0" rpy="0 0 0"/>
  </joint>

  <link name="magnetic_end_effector">
    <!-- Gripper housing -->
    <visual>
      <origin xyz="0.02 0 0" rpy="0 ${pi/2} 0"/>
      <geometry>
        <cylinder radius="0.02" length="0.04"/>
      </geometry>
      <material name="magnet_red"/>
    </visual>
    <!-- Gripper fingers (3 prongs like Canadarm) -->
    <visual>
      <origin xyz="0.05 0.015 0" rpy="0 ${pi/2} 0"/>
      <geometry>
        <cylinder radius="0.005" length="0.03"/>
      </geometry>
      <material name="grey"/>
    </visual>
    <visual>
      <origin xyz="0.05 -0.0075 0.013" rpy="0 ${pi/2} 0"/>
      <geometry>
        <cylinder radius="0.005" length="0.03"/>
      </geometry>
      <material name="grey"/>
    </visual>
    <visual>
      <origin xyz="0.05 -0.0075 -0.013" rpy="0 ${pi/2} 0"/>
      <geometry>
        <cylinder radius="0.005" length="0.03"/>
      </geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin xyz="0.03 0 0" rpy="0 ${pi/2} 0"/>
      <geometry>
        <cylinder radius="0.025" length="0.06"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
  </link>

  <!-- Magnet contact point -->
  <link name="magnet_contact_point">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.008"/>
      </geometry>
      <material name="magnet_red"/>
    </visual>
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="0.0000001" ixy="0" ixz="0" iyy="0.0000001" iyz="0" izz="0.0000001"/>
    </inertial>
  </link>

  <joint name="magnet_contact_joint" type="fixed">
    <parent link="magnetic_end_effector"/>
    <child link="magnet_contact_point"/>
    <origin xyz="0.065 0 0" rpy="0 0 0"/>
  </joint>

  <!-- =========================================== -->
  <!-- Gazebo Plugins and Controllers (ROS2) -->
  <!-- =========================================== -->

  <!-- ros2_control hardware interface for MoveIt2 -->
  <ros2_control name="chaser_arm_control" type="system">
    <hardware>
      <plugin>gazebo_ros2_control/GazeboSystem</plugin>
    </hardware>
    <joint name="joint1">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint2">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint3">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint4">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint5">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint6">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <!-- Gazebo ros2_control plugin (temporarily disabled - parameter parsing issue)
  <gazebo>
    <plugin filename="libgazebo_ros2_control.so" name="gazebo_ros2_control">
      <robot_param>robot_description</robot_param>
      <robot_param_node>robot_state_publisher</robot_param_node>
      <parameters>$(find hpop_gazebo)/config/arm_controllers.yaml</parameters>
    </plugin>
  </gazebo>
  -->

  <!-- Gazebo materials -->
  <gazebo reference="base_link">
    <material>Gazebo/DarkGrey</material>
  </gazebo>
  <gazebo reference="solar_panel_1">
    <material>Gazebo/Blue</material>
  </gazebo>
  <gazebo reference="solar_panel_2">
    <material>Gazebo/Blue</material>
  </gazebo>
  <gazebo reference="magnetic_end_effector">
    <material>Gazebo/Red</material>
  </gazebo>
  <gazebo reference="link1"><material>Gazebo/Grey</material></gazebo>
  <gazebo reference="link2"><material>Gazebo/Grey</material></gazebo>
  <gazebo reference="link3"><material>Gazebo/Grey</material></gazebo>
  <gazebo reference="link4"><material>Gazebo/Grey</material></gazebo>
  <gazebo reference="link5"><material>Gazebo/Grey</material></gazebo>
  <gazebo reference="link6"><material>Gazebo/Grey</material></gazebo>
  <gazebo reference="end_link"><material>Gazebo/Grey</material></gazebo>

</robot>
