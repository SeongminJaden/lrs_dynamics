<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="chaser_satellite">

  <!-- Properties -->
  <xacro:property name="satellite_mass" value="1000.0"/>
  <xacro:property name="satellite_size_x" value="2.0"/>
  <xacro:property name="satellite_size_y" value="1.5"/>
  <xacro:property name="satellite_size_z" value="1.0"/>

  <!-- Materials -->
  <material name="gold">
    <color rgba="0.9 0.8 0.2 1.0"/>
  </material>
  <material name="grey">
    <color rgba="0.5 0.5 0.5 1.0"/>
  </material>
  <material name="blue">
    <color rgba="0.2 0.4 0.8 1.0"/>
  </material>
  <material name="magnet_red">
    <color rgba="0.8 0.2 0.2 1.0"/>
  </material>

  <!-- Dummy root link (fixes KDL warning about inertia on root link) -->
  <link name="world"/>

  <joint name="world_to_base" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Base link (satellite body) -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${satellite_size_x} ${satellite_size_y} ${satellite_size_z}"/>
      </geometry>
      <material name="gold"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${satellite_size_x} ${satellite_size_y} ${satellite_size_z}"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${satellite_mass}"/>
      <inertia ixx="${satellite_mass*(satellite_size_y*satellite_size_y+satellite_size_z*satellite_size_z)/12}"
               ixy="0" ixz="0"
               iyy="${satellite_mass*(satellite_size_x*satellite_size_x+satellite_size_z*satellite_size_z)/12}"
               iyz="0"
               izz="${satellite_mass*(satellite_size_x*satellite_size_x+satellite_size_y*satellite_size_y)/12}"/>
    </inertial>
  </link>

  <!-- Solar panel 1 -->
  <link name="solar_panel_1">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="3.0 0.05 1.5"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="3.0 0.05 1.5"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="50.0"/>
      <inertia ixx="10" ixy="0" ixz="0" iyy="40" iyz="0" izz="40"/>
    </inertial>
  </link>

  <joint name="solar_panel_1_joint" type="fixed">
    <parent link="base_link"/>
    <child link="solar_panel_1"/>
    <origin xyz="0 1.5 0" rpy="0 0 0"/>
  </joint>

  <!-- Solar panel 2 -->
  <link name="solar_panel_2">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="3.0 0.05 1.5"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="3.0 0.05 1.5"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="50.0"/>
      <inertia ixx="10" ixy="0" ixz="0" iyy="40" iyz="0" izz="40"/>
    </inertial>
  </link>

  <joint name="solar_panel_2_joint" type="fixed">
    <parent link="base_link"/>
    <child link="solar_panel_2"/>
    <origin xyz="0 -1.5 0" rpy="0 0 0"/>
  </joint>

  <!-- Arm mounting point -->
  <link name="arm_base">
    <visual>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.15" length="0.1"/>
      </geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.15" length="0.1"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="5.0"/>
      <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1"/>
    </inertial>
  </link>

  <joint name="arm_base_joint" type="fixed">
    <parent link="base_link"/>
    <child link="arm_base"/>
    <origin xyz="0.8 0 0.5" rpy="0 0 0"/>
  </joint>

  <!-- =========================================== -->
  <!-- OpenMANIPULATOR-P Robot Arm (6 DOF) -->
  <!-- =========================================== -->

  <!-- Link 1 -->
  <link name="link1">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://hpop_gazebo/meshes/link1.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://hpop_gazebo/meshes/link1.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.00023 0.00000 0.06223" rpy="0 0 0"/>
      <mass value="0.85644"/>
      <inertia ixx="0.00121" ixy="0.0" ixz="0.00001" iyy="0.00121" iyz="0.0" izz="0.00038"/>
    </inertial>
  </link>

  <joint name="arm_mount_joint" type="fixed">
    <parent link="arm_base"/>
    <child link="link1"/>
    <origin xyz="0 0 0.1" rpy="0 0 0"/>
  </joint>

  <!-- Joint 1 -->
  <joint name="joint1" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="0.0 0.0 0.126" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit velocity="6.5" effort="1000" lower="${-pi*0.9}" upper="${pi*0.9}"/>
    <dynamics damping="0.7"/>
  </joint>

  <!-- Link 2 -->
  <link name="link2">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://hpop_gazebo/meshes/link2.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://hpop_gazebo/meshes/link2.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.00000 0.00080 0.03183" rpy="0 0 0"/>
      <mass value="0.94658"/>
      <inertia ixx="0.00153" ixy="0.0" ixz="0.0" iyy="0.00046" iyz="-0.00001" izz="0.00152"/>
    </inertial>
  </link>

  <!-- Joint 2 -->
  <joint name="joint2" type="revolute">
    <parent link="link2"/>
    <child link="link3"/>
    <origin xyz="0.0 0.069 0.033" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit velocity="6.5" effort="1000" lower="${-pi*0.5}" upper="${pi*0.5}"/>
    <dynamics damping="0.7"/>
  </joint>

  <!-- Link 3 -->
  <link name="link3">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://hpop_gazebo/meshes/link3.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://hpop_gazebo/meshes/link3.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.01768 -0.06881 0.20524" rpy="0 0 0"/>
      <mass value="1.30260"/>
      <inertia ixx="0.01111" ixy="0.00001" ixz="-0.00134" iyy="0.01047" iyz="0.00016" izz="0.00202"/>
    </inertial>
  </link>

  <!-- Joint 3 -->
  <joint name="joint3" type="revolute">
    <parent link="link3"/>
    <child link="link4"/>
    <origin xyz="0.03000 -0.01150 0.26400" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit velocity="6.5" effort="1000" lower="${-pi*0.5}" upper="${pi*0.5}"/>
    <dynamics damping="0.7"/>
  </joint>

  <!-- Link 4 -->
  <link name="link4">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://hpop_gazebo/meshes/link4.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://hpop_gazebo/meshes/link4.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.12475 -0.05716 0.02979" rpy="0 0 0"/>
      <mass value="1.15977"/>
      <inertia ixx="0.00097" ixy="0.00004" ixz="-0.00003" iyy="0.00319" iyz="0.00001" izz="0.00341"/>
    </inertial>
  </link>

  <!-- Joint 4 -->
  <joint name="joint4" type="revolute">
    <parent link="link4"/>
    <child link="link5"/>
    <origin xyz="0.19500 -0.05750 0.03000" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit velocity="6.5" effort="1000" lower="${-pi*0.9}" upper="${pi*0.9}"/>
    <dynamics damping="0.7"/>
  </joint>

  <!-- Link 5 -->
  <link name="link5">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://hpop_gazebo/meshes/link5.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://hpop_gazebo/meshes/link5.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.05642 -0.00217 0.00002" rpy="0 0 0"/>
      <mass value="0.44688"/>
      <inertia ixx="0.00030" ixy="0.00001" ixz="0.0" iyy="0.00022" iyz="0.0" izz="0.00040"/>
    </inertial>
  </link>

  <!-- Joint 5 -->
  <joint name="joint5" type="revolute">
    <parent link="link5"/>
    <child link="link6"/>
    <origin xyz="0.06300 0.04500 0.00000" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit velocity="6.5" effort="1000" lower="${-pi*0.5}" upper="${pi*0.5}"/>
    <dynamics damping="0.7"/>
  </joint>

  <!-- Link 6 -->
  <link name="link6">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://hpop_gazebo/meshes/link6.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://hpop_gazebo/meshes/link6.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.06831 -0.04457 0.00000" rpy="0 0 0"/>
      <mass value="0.43273"/>
      <inertia ixx="0.00022" ixy="0.00001" ixz="0.0" iyy="0.00043" iyz="0.0" izz="0.00051"/>
    </inertial>
  </link>

  <!-- Joint 6 -->
  <joint name="joint6" type="revolute">
    <parent link="link6"/>
    <child link="end_link"/>
    <origin xyz="0.12300 -0.04500 0.00000" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit velocity="6.5" effort="1000" lower="${-pi*0.9}" upper="${pi*0.9}"/>
    <dynamics damping="0.7"/>
  </joint>

  <!-- End link (original) -->
  <link name="end_link">
    <visual>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://hpop_gazebo/meshes/end_link.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://hpop_gazebo/meshes/end_link.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.00337 0.00000 0.00000" rpy="0 0 0"/>
      <mass value="0.01919"/>
      <inertia ixx="0.00001" ixy="0.0" ixz="0.0" iyy="0.00001" iyz="0.0" izz="0.00001"/>
    </inertial>
  </link>

  <!-- =========================================== -->
  <!-- Magnetic End Effector -->
  <!-- =========================================== -->

  <joint name="magnet_joint" type="fixed">
    <parent link="end_link"/>
    <child link="magnetic_end_effector"/>
    <origin xyz="0.05 0 0" rpy="0 0 0"/>
  </joint>

  <link name="magnetic_end_effector">
    <visual>
      <origin xyz="0 0 0" rpy="0 ${pi/2} 0"/>
      <geometry>
        <cylinder radius="0.04" length="0.08"/>
      </geometry>
      <material name="magnet_red"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 ${pi/2} 0"/>
      <geometry>
        <cylinder radius="0.04" length="0.08"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <!-- Magnet contact sensor link -->
  <link name="magnet_contact_point">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.01"/>
      </geometry>
      <material name="magnet_red"/>
    </visual>
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
  </link>

  <joint name="magnet_contact_joint" type="fixed">
    <parent link="magnetic_end_effector"/>
    <child link="magnet_contact_point"/>
    <origin xyz="0.04 0 0" rpy="0 0 0"/>
  </joint>

  <!-- =========================================== -->
  <!-- Gazebo Plugins and Controllers -->
  <!-- =========================================== -->

  <gazebo>
    <!-- ros2_control for joint position control -->
    <plugin filename="libgazebo_ros2_control.so" name="gazebo_ros2_control">
      <robot_param>robot_description</robot_param>
      <robot_param_node>robot_state_publisher</robot_param_node>
      <parameters>$(find hpop_gazebo)/config/arm_controllers.yaml</parameters>
    </plugin>
  </gazebo>

  <!-- Joint transmissions for ros2_control -->
  <ros2_control name="chaser_arm_control" type="system">
    <hardware>
      <plugin>gazebo_ros2_control/GazeboSystem</plugin>
    </hardware>
    <joint name="joint1">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint2">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint3">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint4">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint5">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint6">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <!-- Gazebo material colors -->
  <gazebo reference="base_link">
    <material>Gazebo/Gold</material>
  </gazebo>
  <gazebo reference="solar_panel_1">
    <material>Gazebo/Blue</material>
  </gazebo>
  <gazebo reference="solar_panel_2">
    <material>Gazebo/Blue</material>
  </gazebo>
  <gazebo reference="magnetic_end_effector">
    <material>Gazebo/Red</material>
  </gazebo>

</robot>
