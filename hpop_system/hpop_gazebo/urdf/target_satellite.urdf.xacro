<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="target_satellite">

  <!-- Properties - 3U CubeSat size (10cm x 10cm x 30cm) scaled for visualization -->
  <xacro:property name="cubesat_unit" value="0.1"/>  <!-- 10cm = 1U -->
  <xacro:property name="satellite_mass" value="5.0"/>  <!-- 5kg for 3U CubeSat -->
  <xacro:property name="satellite_size_x" value="${cubesat_unit}"/>
  <xacro:property name="satellite_size_y" value="${cubesat_unit}"/>
  <xacro:property name="satellite_size_z" value="${3*cubesat_unit}"/>  <!-- 3U = 30cm -->

  <!-- Materials -->
  <material name="silver">
    <color rgba="0.7 0.7 0.7 1.0"/>
  </material>
  <material name="dark_grey">
    <color rgba="0.3 0.3 0.3 1.0"/>
  </material>
  <material name="solar_blue">
    <color rgba="0.1 0.2 0.5 1.0"/>
  </material>
  <material name="docking_green">
    <color rgba="0.2 0.8 0.2 1.0"/>
  </material>
  <material name="target_orange">
    <color rgba="1.0 0.5 0.0 1.0"/>
  </material>

  <!-- Dummy root link for KDL (no inertia) -->
  <link name="target_dummy_root"/>

  <joint name="target_dummy_to_base" type="fixed">
    <parent link="target_dummy_root"/>
    <child link="target_base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Base link (satellite body - 3U CubeSat) -->
  <link name="target_base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${satellite_size_x} ${satellite_size_y} ${satellite_size_z}"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${satellite_size_x} ${satellite_size_y} ${satellite_size_z}"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${satellite_mass}"/>
      <inertia ixx="${satellite_mass*(satellite_size_y*satellite_size_y+satellite_size_z*satellite_size_z)/12}"
               ixy="0" ixz="0"
               iyy="${satellite_mass*(satellite_size_x*satellite_size_x+satellite_size_z*satellite_size_z)/12}"
               iyz="0"
               izz="${satellite_mass*(satellite_size_x*satellite_size_x+satellite_size_y*satellite_size_y)/12}"/>
    </inertial>
  </link>

  <!-- Solar panels removed - disabled debris satellite -->

  <!-- =========================================== -->
  <!-- Magnetic Docking Port (Target side) -->
  <!-- =========================================== -->

  <!-- Docking port structure (scaled for 3U CubeSat) -->
  <link name="docking_port">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.015" length="0.02"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.015" length="0.02"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
  </link>

  <joint name="docking_port_joint" type="fixed">
    <parent link="target_base_link"/>
    <child link="docking_port"/>
    <origin xyz="${satellite_size_x/2 + 0.01} 0 0" rpy="0 ${pi/2} 0"/>
  </joint>

  <!-- Magnetic contact surface -->
  <link name="magnetic_contact_surface">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.012" length="0.005"/>
      </geometry>
      <material name="docking_green"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.012" length="0.005"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.02"/>
      <inertia ixx="0.000001" ixy="0" ixz="0" iyy="0.000001" iyz="0" izz="0.000001"/>
    </inertial>
  </link>

  <joint name="magnetic_surface_joint" type="fixed">
    <parent link="docking_port"/>
    <child link="magnetic_contact_surface"/>
    <origin xyz="0 0 0.012" rpy="0 0 0"/>
  </joint>

  <!-- Antenna (scaled for 3U CubeSat) -->
  <link name="target_antenna">
    <visual>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.004" length="0.06"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <visual>
      <origin xyz="0 0 0.07" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.008"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.01" length="0.08"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.02"/>
      <inertia ixx="0.000001" ixy="0" ixz="0" iyy="0.000001" iyz="0" izz="0.000001"/>
    </inertial>
  </link>

  <joint name="target_antenna_joint" type="fixed">
    <parent link="target_base_link"/>
    <child link="target_antenna"/>
    <origin xyz="-0.02 0 ${satellite_size_z/2}" rpy="0 0 0"/>
  </joint>

  <!-- =========================================== -->
  <!-- Gazebo Properties -->
  <!-- =========================================== -->

  <gazebo reference="target_base_link">
    <material>Gazebo/Orange</material>
  </gazebo>
  <!-- Solar panels removed -->
  <gazebo reference="docking_port">
    <material>Gazebo/DarkGrey</material>
  </gazebo>
  <gazebo reference="magnetic_contact_surface">
    <material>Gazebo/Green</material>
  </gazebo>
  <gazebo reference="target_antenna">
    <material>Gazebo/Grey</material>
  </gazebo>

</robot>
